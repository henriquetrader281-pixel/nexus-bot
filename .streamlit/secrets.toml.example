# Copie este conteúdo para o campo Secrets da Streamlit Community Cloud.
# Nunca faça commit da chave real neste ficheiro ou no repositório.

TWELVEDATA_API_KEY = "cole_a_sua_chave_aqui"

# Configuração opcional da Máquina de Vídeos.
# O modo local é o padrão e não exige chave nem cobrança por chamada.
# NEXUS_AI_PROVIDER = "local"
# Para um endpoint compatível com Chat Completions:
# NEXUS_AI_PROVIDER = "openai-compatible"
# NEXUS_OPENAI_API_KEY = "cole_a_chave_apenas_no_ambiente_local"
# NEXUS_OPENAI_BASE_URL = "https://seu-endpoint/v1"
# NEXUS_AGENT_ROTEIRO_MODEL = "gpt-5-mini"
# NEXUS_AGENT_DIRECAO_VISUAL_MODEL = "gemini-3-flash-preview"
# NEXUS_AGENT_ANALISTA_MODEL = "gpt-5-mini"
# NEXUS_VIDEO_MEMORY = ".nexus_media/video_memory.json"

# Opcional: símbolos alternativos confirmados na sua conta TwelveData.
# TWELVEDATA_SYMBOL_USDJPY = "USD/JPY"
# TWELVEDATA_SYMBOL_US100 = "NDX"
# TWELVEDATA_SYMBOL_XAUUSD = "XAU/USD"
